# =============================================================================
# VAL CoPilot Workspace — root environment (dotenv)
# Copy to `.env` and fill in values. Do NOT duplicate this file under subfolders.
# =============================================================================

# --- Azure OpenAI (Cognitive Routing Agent) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Microsoft Fabric SQL (Gold Layer via ODBC Driver 18) ---
FABRIC_SQL_SERVER=your-workspace.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=gold_layer
FABRIC_SQL_DRIVER=ODBC Driver 18 for SQL Server
# Authentication is always ActiveDirectoryDefault (enforced in code)

# --- Azure AI Search (hybrid semantic) ---
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=documents
AZURE_SEARCH_SEMANTIC_CONFIG=default

# --- Postgres / PGVector (Operational Memory MCP via uvx) ---
PGVECTOR_DATABASE_URL=postgresql://user:password@localhost:5432/val_memory
# Optional args passed through to mcp-server-pgvector
PGVECTOR_COLLECTION=val_operational_memory

# --- Bot Framework / Cognitive Routing Agent ---
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
COPILOT_HOST=0.0.0.0
COPILOT_PORT=3978

# --- Validation UI ---
COPILOT_MESSAGES_URL=http://localhost:3978/api/messages
